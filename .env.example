
# Backend Authentication
# Set to 'true' to require login. Requires running via the Node.js backend (hybrid mode)
REQUIRE_AUTH=false

# You can change the admin username to anything you want (e.g., your name, 'root', etc.), default is admin
ADMIN_USERNAME=admin

# Option A: Plaintext password (easy, hashes in RAM on boot)
ADMIN_PASSWORD='change_me_to_a_strong_password'

# Option B: Pre-hashed password (most secure)
# Generate with: npx argon2-cli -e 'your_password'
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=4096,t=3,p=1$SALT$HASH'

# Session Secret (Required for secure cookies)
# Generate a random string using: openssl rand -hex 32
# If left empty, the app will fall back to an insecure default secret.
SESSION_SECRET='change_me_to_a_long_random_string'

# ==========================
# AWS / S3-Compatible (Legacy & Generic)
# ==========================
AWS_S3_REGION=
AWS_S3_ID=
AWS_S3_KEY=
AWS_S3_BASKET=
AWS_S3_URL=

S3_ENDPOINT=          # leave empty for real AWS
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=        # optional CDN / custom domain

# ==========================
# Cloudflare R2 specific
# ==========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ==========================
# Supabase
# ==========================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=

# ==========================
# Custom HTTP Endpoint
# ==========================
CUSTOM_UPLOAD_URL=
CUSTOM_UPLOAD_HEADERS=   # JSON string
