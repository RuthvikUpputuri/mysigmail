# Storage Provider configuration
# Available providers: aws|r2|supabase|minio|do|b2|wasabi|s3|none|custom
VITE_STORAGE_PROVIDER=none

# Backend Authentication
# Set to 'true' to require login. Requires running via the Node.js backend (hybrid mode)
VITE_REQUIRE_AUTH=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# ==========================
# AWS / S3-Compatible (Legacy & Generic)
# ==========================
VITE_AWS_S3_REGION=
VITE_AWS_S3_ID=
VITE_AWS_S3_KEY=
VITE_AWS_S3_BASKET=
VITE_AWS_S3_URL=

VITE_S3_ENDPOINT=          # leave empty for real AWS
VITE_S3_REGION=
VITE_S3_BUCKET=
VITE_S3_ACCESS_KEY_ID=
VITE_S3_SECRET_ACCESS_KEY=
VITE_S3_PUBLIC_URL=        # optional CDN / custom domain

# ==========================
# Cloudflare R2 specific
# ==========================
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET=
VITE_R2_PUBLIC_URL=

# ==========================
# Supabase
# ==========================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=

# ==========================
# Custom HTTP Endpoint
# ==========================
VITE_CUSTOM_UPLOAD_URL=
VITE_CUSTOM_UPLOAD_HEADERS=   # JSON string
